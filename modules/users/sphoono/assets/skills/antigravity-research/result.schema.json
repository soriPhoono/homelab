{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antigravity research result",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "wiki_pages", "open_questions"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two or three sentences answering the question."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "sources", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "wiki_pages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths relative to $AGENT_WIKI that were created or updated."
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
